 "hotel_facts": [
  {
   "label": "Check in, check out",
   "text": "Check in at 4 PM, check out at 11 AM.",
   "source": "https://www.marriott.com/hotels/maps/travel/msysh-springhill-suites-new-orleans-warehouse-arts-district/"
  },
  {
   "label": "Front desk",
   "text": "504-522-3100, staffed around the clock.",
   "source": "https://www.marriott.com/hotels/maps/travel/msysh-springhill-suites-new-orleans-warehouse-arts-district/"
  },
  {
   "label": "Breakfast and pool",
   "text": "Breakfast is free, and there's an outdoor pool. The hours come from a third-party listing, so ask at the desk.",
   "source": "https://www.hotelplanner.com/Hotels/339668/Reservations-Springhill-Suites-New-Orleans-Warehouse-Arts-District-New-Orleans-301-Saint-Joseph-St-70130?gencall=1"
  },
  {
   "label": "Valet",
   "text": "$47 a day, and spots are limited.",
   "source": "https://www.marriott.com/hotels/maps/travel/msysh-springhill-suites-new-orleans-warehouse-arts-district/"
  }
 ],
 "transit": [
  {
   "label": "On foot",
   "text": "Bourbon Street and the Superdome are 20 to 30 minutes on foot, by our estimate. The French Quarter is better by rideshare after dark.",
   "source": ""
  },
  {
   "label": "Streetcar",
   "text": "$1.25 a ride, or a Jazzy Pass for $3 a day. The St. Charles line runs downtown. The Canal line only goes as far as Canal and LaSalle. Drivers don't make change.",
   "source": "https://www.norta.com/getmedia/7e0fdb3f-1712-4ea8-994f-1f5f9f4cb474/Streetcars.pdf"
  },
  {
   "label": "Airport taxi",
   "text": "A flat $36 to downtown for up to two people. Airport taxis take cards.",
   "source": "https://flymsy.com/taxis-2"
  },
  {
   "label": "To the shows",
   "text": "Your bus pass covers the ride to the UNO Lakefront Arena and back, from the Maple Leaf Bar on Oak Street. Get to the Maple Leaf by 4 both days, about 16 to 25 minutes Uptown by rideshare (estimate).",
   "source": "https://www.mapleleafbar.com/events/wsp-bus-ticket-package-10-30"
  },
  {
   "label": "Clocks",
   "text": "Clocks fall back at 2 AM Sunday. Sunday's sunset is 5:13 PM.",
   "source": "https://api.weather.gov/gridpoints/LIX/68,88/forecast"
  }
 ],
 "nearby": [
  {
   "name": "Walgreens, 900 Canal St",
   "text": "The nearest pharmacy we could confirm, about 0.8 miles.",
   "source": [
    "https://nominatim.openstreetmap.org/"
   ]
  }
 ],
 "safety": [
  {
   "label": "Getting home late",
   "text": "Take Uber or Lyft after midnight rather than hailing a cab, and check the plate and the driver's name.",
   "source": "https://www.nomadotravel.app/en/guides/new-orleans-safety-tips"
  },
  {
   "label": "Go cups",
   "text": "In the French Quarter you can walk out of a bar with a drink in a plastic cup, never glass or a can.",
   "source": "https://traveler.marriott.com/new-orleans/quirky-nola-laws-you-should-know-before-you-go/"
  },
  {
   "label": "Last call",
   "text": "New Orleans has no set closing time, so some bars run all night.",
   "source": "https://traveler.marriott.com/new-orleans/quirky-nola-laws-you-should-know-before-you-go/"
  }
 ],
